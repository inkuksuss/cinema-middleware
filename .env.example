# =============================================================================
# 접속 정보 env 템플릿 — 이 파일만 커밋한다. 값은 비워 두고 키 이름만 적는다.
#
# 아래 세 구역을 각각의 파일로 복사해 값을 채운다(세 파일 모두 .gitignore 대상).
#   cp .env.example .env        # [공통 인프라] 구역만 남긴다
#   cp .env.example .env.dev    # [앱] 구역만 남긴다 — docker-compose-dev.yml
#   cp .env.example .env.prod   # [앱] 구역만 남긴다 — docker-compose-prod.yml
#
# 주의
# - mysql-data 볼륨은 최초 기동 때의 MYSQL_* 값으로 계정이 만들어진다.
#   이후 .env 의 값을 바꿔도 기존 DB 계정은 바뀌지 않으므로 접속이 실패한다.
# - 로컬은 dev·prod 앱이 같은 MySQL 을 쓴다. .env.dev/.env.prod 의 계정은 .env 의 MYSQL_USER/MYSQL_PASSWORD 와 같아야 한다.
# =============================================================================

# ----- [공통 인프라] .env — docker-compose.yml(mysql·redis) + 앱 포트 + scripts/ -----
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# 호스트에 노출할 포트
MYSQL_HOST_PORT=
REDIS_HOST_PORT=
APP_HOST_PORT=

# ----- [앱] .env.dev / .env.prod — 앱 컨테이너 접속 정보 -----
# compose 네트워크 안에서는 서비스 이름(mysql, redis)과 컨테이너 포트(3306, 6379)로 접속한다.
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
SPRING_DATA_REDIS_HOST=
SPRING_DATA_REDIS_PORT=
